# ---- required ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/govi-isuru
# at least 16 characters each; the server refuses to start in production without them
JWT_SECRET=
REFRESH_TOKEN_SECRET=
# browser origins allowed to call the API (the Next.js app), comma separated
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ---- AI service (repo govi-isuru-ai-service) ---------------------------------
AI_SERVICE_URL=http://localhost:8000
# must equal GOVI_API_KEY of the AI service
AI_SERVICE_KEY=
AI_TIMEOUT_MS=20000

# ---- optional integrations ---------------------------------------------------
UPLOADS_DIR=./uploads
NEWS_API_KEY=
WEATHER_API_KEY=
HUGGINGFACE_API_TOKEN=
# Gemini chatbot / speech (Google Cloud service account)
GOOGLE_CLOUD_PROJECT=
GOOGLE_VERTEX_LOCATION=
GOOGLE_GEMINI_MODEL=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
# web push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Live voice (Gemini Live on Vertex AI; uses the Google service account above)
GOOGLE_GEMINI_LIVE_MODEL=

# WhatsApp bot (folder whatsapp-bot/). Shared secret between this API and the bot.
WHATSAPP_BOT_KEY=
WHATSAPP_BOT_URL=http://localhost:7000
BOT_PHONE_NUMBER=
WHATSAPP_DEMO_USERNAME=demo-judge

# First admin account (scripts/create-admin.js); the password is set by the person on first sign-in
ADMIN_EMAIL=

# Photo storage (Cloudinary). Empty = photos are kept on this server's disk (lost on Render free restarts)
CLOUDINARY_URL=

# Daily.co video consultations
DAILY_API_KEY=
VIDEO_JOIN_EARLY_MINUTES=30
VIDEO_JOIN_LATE_MINUTES=120
MANUAL_BOOKING_FEE_CREDITS=
ADVICE_FEE_CREDITS=
